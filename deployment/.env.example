# Trasi — variabili d'ambiente dello stack (ESEMPIO, senza segreti reali).
#
# Copiare in `.env` e sostituire OGNI valore `CHANGE_ME` con un segreto generato.
# Il file `.env` reale NON va committato e deve avere mode 600:
#     install -m 600 .env.example .env
#
# Generazione segreti (esempi):
#     openssl rand -base64 32 | tr -d '/+=' | head -c 32   # password/secret URL-safe
#     openssl rand -hex 16                                  # AP_ENCRYPTION_KEY (32 hex)

# ---------------------------------------------------------------- dominio e fuso ----------
# Trasi Home / NocoDB / Metabase stanno sul dominio Trasi; Onyx su sottodominio
# (Onyx non ha basePath: v. plan §0.3, «Onyx su sottodominio»).
TRASI_DOMAIN=trasi.lascuolaopensource.org
ONYX_DOMAIN=onyx.lascuolaopensource.org
TZ=Europe/Rome

# ---------------------------------------------------------------- Postgres Trasi + PostGIS ----------
# db_trasi è il DB di dominio (schema `trasi`, RLS). I RUOLI non stanno nel dump del DB:
# il backup giornaliero (ops/backup.sh, B6) include `pg_dumpall --globals-only`.
TRASI_DB=trasi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Bind SOLO su loopback: la pubblicazione esterna passa dal tunnel Cloudflare.
HOST_PORT_DB=5432

# DSN usato dallo shim (B3). Ruolo applicativo `shim_rw` (NOINHERIT), creato in B1 da
# `db/000_roles.sql`: lo shim esegue `BEGIN; SET LOCAL ROLE <ruolo_casa>; …; COMMIT` per richiesta.
# NB: il ruolo shim_rw deve essere creato con QUESTA password (B1-DAT-01).
SHIM_DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://shim_rw:CHANGE_ME@db_trasi:5432/trasi_db

# ---------------------------------------------------------------- shim (contratto V-09, CONGELATO) -----
# Build dal worker trasi-shim: directory `../shim`, porta interna 8000, healthcheck GET /healthz.
# Non cambiare nomi/valori senza riconciliare il contratto con quel worker.
TRASI_SHIM_KEY=CHANGE_ME
HOST_PORT_SHIM=8001

# ---------------------------------------------------------------- Overpass (OSM) ----------------------
# `overpass-api.de` NON è utilizzabile da questo host (verificato 15/09: risponde 406/504
# a seconda di metodo e User-Agent). Endpoint primario: istanza francese.
# ATTENZIONE (misurato 15/09): le istanze Overpass filtrano per User-Agent — l'istanza .fr
# risponde **403 «only available to white-listed usages»** se lo User-Agent è quello di
# python-httpx/python-requests. Il client dello shim (B3-SHM-04) DEVE inviare uno User-Agent
# esplicito e non-python, es. `Trasi/1.0 (+https://trasi.lascuolaopensource.org)`.
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
OVERPASS_URL_2=https://overpass-api.de/api/interpreter

# ---------------------------------------------------------------- SearXNG (interno) -------------------
# Nessuna porta pubblica: lo interroga solo lo shim su http://searxng:8080.
SEARXNG_SECRET=CHANGE_ME

# ---------------------------------------------------------------- NocoDB (CRM + coda proposte) --------
NOCODB_JWT_SECRET=CHANGE_ME
NOCODB_SITE_URL=https://trasi.lascuolaopensource.org/nocodb
HOST_PORT_NOCODB=8081

# ---------------------------------------------------------------- Metabase (dashboard) ----------------
# App DB su file H2 nel volume `metabase_data` (scelta B0: nessun terzo Postgres, budget RAM).
# La SOURCE verso il dominio Trasi è separata: ruolo `metabase_ro` (sola lettura), configurata in B5.
METABASE_DB_TYPE=h2
METABASE_SITE_URL=https://trasi.lascuolaopensource.org/metabase
HOST_PORT_METABASE=3001

# ---------------------------------------------------------------- Activepieces (automazioni) ----------
# Vuole Postgres + Redis PROPRI: non condivide il DB di dominio.
ACTIVEPIECES_SITE_URL=http://127.0.0.1:8082
ACTIVEPIECES_JWT_SECRET=CHANGE_ME
# 256 bit = 32 caratteri esadecimali.
ACTIVEPIECES_ENCRYPTION_KEY=CHANGE_ME
AP_POSTGRES_DB=activepieces
AP_POSTGRES_USER=activepieces
AP_POSTGRES_PASSWORD=CHANGE_ME
HOST_PORT_ACTIVEPIECES=8082

# ---------------------------------------------------------------- servizio `automazioni` (B4) ----------
# Flussi notturni: `deployment/docker-compose.automazioni.yml`, incluso dal compose principale.
# Il container si connette al DB come ruolo applicativo `automazioni` (mai `postgres`): la scrittura
# della memoria passa da proposta → approvazione → `applica_proposte_approvate` (V4).
# La password è provisionata da `flussi/provisiona.sh` (che la applica al ruolo e non la stampa).
AUTOMAZIONI_DB_PASSWORD=CHANGE_ME
# Export KB (F3) verso la Ingestion API di Onyx. La PAT è la stessa dell'export di B2.
ONYX_API_URL=http://nginx/api
ONYX_TRASI_KB_API_KEY=CHANGE_ME
ONYX_TRASI_KB_PAT_ID=3
ONYX_KB_CC_PAIR_ID=3
# SMTP degli alert (F6). Se assente, gli alert vanno su file in `flussi/evidenze/alert/`
# e il modo è dichiarato in `flusso_run.dettaglio.modo` — non è un ripiego silenzioso.
TRASI_SMTP_HOST=
TRASI_SMTP_PORT=25
TRASI_SMTP_USER=
TRASI_SMTP_PASSWORD=
TRASI_SMTP_FROM=trasi@trasi.local

# ---------------------------------------------------------------- Caddy (ingresso unico) --------------
# L'host ha già onyx-nginx su 127.0.0.1:80 e 127.0.0.1:3000: Caddy usa porte diverse, sempre loopback.
# Il tunnel Cloudflare instrada i sottodomini verso queste porte.
HOST_PORT_CADDY_HTTP=8088
HOST_PORT_CADDY_HTTPS=8443
