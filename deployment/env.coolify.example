# Trasi — variabili per il deploy su Coolify (giorgio / broolify.lascuolaopensource.org).
# Da incollare nelle Environment Variables dell'applicazione Coolify (o in un .env dedicato).
#
# Differenze rispetto a onice:
#   - niente HOST_PORT_*: nessuna porta host è pubblicata, l'ingresso è coolify-proxy (Traefik);
#   - niente ONYX_*: su giorgio non c'è Onyx (la chat shim e l'export KB restano dipendenze
#     dichiarate: rispondono 503 finché Onyx non è raggiungibile);
#   - DATABASE_URL e NC_DB puntano al servizio del compose tramite ${SERVICE_NAME_DB_TRASI},
#     che Coolify genera da solo (db_trasi in produzione, db_trasi-pr-<N> nelle anteprime PR).

TZ=Europe/Rome

# Postgres dominio
TRASI_DB=trasi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
SHIM_DB_PASSWORD=CHANGE_ME

# Shim
TRASI_SHIM_KEY=CHANGE_ME

# NocoDB: metadati su database DEDICATO, non sul dominio (permission denied su schema public
# altrimenti: nocodb gira le sue migrazioni su `public` del DB che gli si passa).
NOCODB_DB_HOST=db_trasi
NOCODB_DB_NAME=nocodb_db
NOCODB_JWT_SECRET=CHANGE_ME
NOCODB_SITE_URL=https://trasi.br.lascuolaopensource.org/nocodb

# Metabase (H2 su volume, come su onice)
METABASE_DB_TYPE=h2
METABASE_SITE_URL=https://trasi.br.lascuolaopensource.org/metabase

# Activepieces
ACTIVEPIECES_SITE_URL=https://trasi.br.lascuolaopensource.org/activepieces
ACTIVEPIECES_JWT_SECRET=CHANGE_ME
ACTIVEPIECES_ENCRYPTION_KEY=CHANGE_ME
AP_POSTGRES_DB=activepieces
AP_POSTGRES_USER=activepieces
AP_POSTGRES_PASSWORD=CHANGE_ME

# Overpass (UA non-python obbligatorio: v. README «User-Agent obbligatorio»)
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
OVERPASS_URL_2=https://overpass-api.de/api/interpreter
