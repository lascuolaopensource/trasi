{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/base/**",
              "components/chat/**",
              "components/dati/**",
              "components/destinazioni/**",
              "components/navigazione/**",
              "components/provenienza/**",
              "components/stato/**",
              "ui_kits/trasi-chiedi/**",
              "ui_kits/trasi-home/**",
              "ui_kits/trasi-mappa/**",
              "ui_kits/trasi-osservatorio/**",
              "ui_kits/trasi-registra/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvvisoCoda'] > JSXAttribute > JSXIdentifier[name!=/^(?:numero|giorniPiuVecchia|casa|href|azione|style|key|ref|className|style|children)$/]",
        "message": "<AvvisoCoda> doesn't accept that prop. Declared props: numero, giorniPiuVecchia, casa, href, azione, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bottone'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|dimensione|href|disabilitato|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Bottone> doesn't accept that prop. Declared props: variante, dimensione, href, disabilitato, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bottone'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:principale|secondaria|quieta|suScuro)$/]",
        "message": "<Bottone> variante must be one of 'principale' | 'secondaria' | 'quieta' | 'suScuro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bottone'] > JSXAttribute[name.name='dimensione'] > Literal[value!=/^(?:normale|compatta)$/]",
        "message": "<Bottone> dimensione must be one of 'normale' | 'compatta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampoTesto'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|etichetta|aiuto|valore|onChange|righe|segnaposto|larghezza|key|ref|className|style|children)$/]",
        "message": "<CampoTesto> doesn't accept that prop. Declared props: id, etichetta, aiuto, valore, onChange, righe, segnaposto, larghezza."
      },
      {
        "selector": "JSXOpeningElement[name.name='Destinazione'] > JSXAttribute > JSXIdentifier[name!=/^(?:titolo|testo|href|variante|attivo|nota|contatore|style|children|key|ref|className|style|children)$/]",
        "message": "<Destinazione> doesn't accept that prop. Declared props: titolo, testo, href, variante, attivo, nota, contatore, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Destinazione'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:principale|secondaria)$/]",
        "message": "<Destinazione> variante must be one of 'principale' | 'secondaria'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Etichetta'] > JSXAttribute > JSXIdentifier[name!=/^(?:tono|bordo|style|children|key|ref|className|style|children)$/]",
        "message": "<Etichetta> doesn't accept that prop. Declared props: tono, bordo, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Etichetta'] > JSXAttribute[name.name='tono'] > Literal[value!=/^(?:attenzione|neutra|informativa)$/]",
        "message": "<Etichetta> tono must be one of 'attenzione' | 'neutra' | 'informativa'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EtichettaProvenienza'] > JSXAttribute > JSXIdentifier[name!=/^(?:tipo|fonte|data|affidabilita|ora|testo|glossa|style|key|ref|className|style|children)$/]",
        "message": "<EtichettaProvenienza> doesn't accept that prop. Declared props: tipo, fonte, data, affidabilita, ora, testo, glossa, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EtichettaProvenienza'] > JSXAttribute[name.name='tipo'] > Literal[value!=/^(?:kb|esterna)$/]",
        "message": "<EtichettaProvenienza> tipo must be one of 'kb' | 'esterna'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Intestazione'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|sottotitolo|casa|azioni|style|key|ref|className|style|children)$/]",
        "message": "<Intestazione> doesn't accept that prop. Declared props: logo, sottotitolo, casa, azioni, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessaggioChat'] > JSXAttribute > JSXIdentifier[name!=/^(?:autore|testo|provenienza|azioni|style|children|key|ref|className|style|children)$/]",
        "message": "<MessaggioChat> doesn't accept that prop. Declared props: autore, testo, provenienza, azioni, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessaggioChat'] > JSXAttribute[name.name='autore'] > Literal[value!=/^(?:operatore|assistente)$/]",
        "message": "<MessaggioChat> autore must be one of 'operatore' | 'assistente'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RigaOggi'] > JSXAttribute > JSXIdentifier[name!=/^(?:stato|testo|nota|style|key|ref|className|style|children)$/]",
        "message": "<RigaOggi> doesn't accept that prop. Declared props: stato, testo, nota, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RigaOggi'] > JSXAttribute[name.name='stato'] > Literal[value!=/^(?:attesa|ok|non-disponibile)$/]",
        "message": "<RigaOggi> stato must be one of 'attesa' | 'ok' | 'non-disponibile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SaltaContenuto'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|key|ref|className|style|children)$/]",
        "message": "<SaltaContenuto> doesn't accept that prop. Declared props: href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Scheda'] > JSXAttribute > JSXIdentifier[name!=/^(?:filetto|elemento|padding|style|children|key|ref|className|style|children)$/]",
        "message": "<Scheda> doesn't accept that prop. Declared props: filetto, elemento, padding, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Casa'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|nome|nota|key|ref|className|style|children)$/]",
        "message": "<Casa> doesn't accept that prop. Declared props: slug, nome, nota."
      },
      {
        "selector": "JSXOpeningElement[name.name='Colonna'] > JSXAttribute > JSXIdentifier[name!=/^(?:titolo|key|ref|className|style|children)$/]",
        "message": "<Colonna> doesn't accept that prop. Declared props: titolo."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
